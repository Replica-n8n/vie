soir","part":0.75,"accompagnement":{"nom":"tagliatelles (suggérées par la recette)","g":195},"kcal":822,"p":55,"g":62,"l":33,"f":4}],"recettes":{"tikka":{"nom":"Poulet tikka au yogourt","lien":"https://www.ricardocuisine.com/recettes/10434-poulet-tikka-au-yogourt","facteur":1.5,"temps":65,"quand":"la cuisson de dimanche","decouverte":true,"ingredients":[{"section":"Poulet mariné","texte":"45 ml de gingembre frais râpé"},{"texte":"6 gousses d'ail"},{"texte":"23 ml de garam masala","nonCompte":true},{"texte":"23 ml de paprika doux"},{"texte":"8 ml de cumin moulu"},{"texte":"4 ml de curcuma"},{"texte":"2 ml de piment de Cayenne"},{"texte":"11 ml de sel"},{"texte":"8 ml d'huile végétale"},{"texte":"270 g de yogourt nature 11 %"},{"texte":"1,4 kg de hauts de cuisses de poulet désossés et sans la peau"},{"section":"Sauce","texte":"330 g d'oignons, émincés"},{"texte":"60 g de beurre"},{"texte":"597 ml de tomates en dés"},{"texte":"375 ml d'eau"},{"texte":"380 g de yogourt nature 11 %"},{"texte":"210 g de bébés épinards"},{"texte":"Feuilles de coriandre, pour le service"},{"section":"Accompagnement","texte":"370 g de riz basmati sec (175 g cuit par assiette, suggéré par la recette)"}],"etapes":["Mélanger gingembre, ail, épices, sel et huile ; poivrer.","Enrober le poulet de yogourt mêlé à la moitié des épices, laisser mariner 4 à 8 heures au frigo.","Sauce : dorer les oignons dans le beurre 7 minutes, ajouter le reste des épices, puis tomates et eau ; mijoter 15 minutes.","Griller le poulet sous le gril du four 6 à 12 minutes, retourner, 4 minutes de plus.","À feu doux, incorporer le yogourt à la sauce, ajouter le poulet 5 minutes sans bouillir, puis les épinards 2 minutes."],"notes":"Marinade de 4 h minimum : à lancer la veille ou le matin du batch. Riz basmati suggéré, non compté."},"boulettes":{"nom":"Boulettes de dindon aux épinards","lien":"https://www.ricardocuisine.com/recettes/9453-boulettes-de-dindon-aux-epinards","facteur":1.75,"temps":51,"quand":"la cuisson de dimanche","decouverte":true,"ingredients":[{"section":"Boulettes","texte":"250 g de bébés épinards"},{"texte":"26 ml d'huile d'olive"},{"texte":"790 g de dindon haché"},{"texte":"70 g de chapelure panko"},{"texte":"2 oeufs"},{"texte":"2 gousses d'ail"},{"section":"Salade de tomates","texte":"740 g de tomates cerises"},{"texte":"79 ml de feuilles de menthe"},{"texte":"53 ml d'huile d'olive"},{"texte":"26 ml de vinaigre de vin blanc"},{"texte":"18 ml de miel"},{"section":"Accompagnement","texte":"210 g de couscous sec (180 g cuit par assiette, suggéré par la recette)"}],"etapes":["Attendrir les épinards 1 minute dans l'huile, les égoutter en pressant et laisser tiédir 15 minutes.","Mélanger épinards, dindon, chapelure, œuf et ail ; saler et poivrer.","Former des boulettes de 45 ml, les déposer sur une plaque (on peut les congeler à cette étape).","Cuire 20 minutes à 220 °C.","Salade : mélanger tomates, menthe, huile, vinaigre et miel ; égoutter au service."],"notes":"Se congèle (boulettes crues ou cuites). Ricardo suggère couscous et yogourt grec en accompagnement : non comptés."},"pad":{"nom":"Pad kra pao au bœuf","lien":"https://hot-thai-kitchen.com/pad-kra-pao-beef/","facteur":0.75,"temps":25,"quand":"mar-soir","ingredients":[{"texte":"5 gousses d'ail"},{"texte":"5 g de piments thaïs"},{"texte":"44 ml de piments rouges doux hachés"},{"texte":"59 ml de piments rouges doux en julienne"},{"texte":"22 ml d'huile végétale"},{"texte":"260 g de bœuf haché (ordinaire ou maigre)"},{"texte":"18 ml de sauce de poisson"},{"texte":"11 ml de sucre"},{"texte":"89 ml de bouillon de bœuf ou de poulet non salé"},{"texte":"1 g de poivre noir moulu"},{"texte":"222 ml de feuilles de basilic sacré ou de basilic ordinaire"},{"texte":"2 œufs (1 par personne)"},{"texte":"Huile pour frire les œufs"},{"texte":"2 g de piments thaïs (prik nam pla)"},{"texte":"22 ml de sauce de poisson (prik nam pla)"},{"texte":"7 ml de jus de lime"},{"texte":"1 gousse d'ail"},{"texte":"Riz jasmin cuit, pour le service"},{"section":"Accompagnement","texte":"140 g de riz jasmin sec (195 g cuit par assiette, suggéré par la recette)"}],"etapes":["Sauce prik nam pla : piments et ail hachés dans la sauce de poisson et le jus de lime.","Piler les piments thaïs, puis l'ail et les piments doux en pâte grossière.","Saisir le bœuf à feu très vif dans un wok, puis ajouter la pâte de piments à feu moyen.","Remonter le feu, ajouter bouillon, sauce de poisson, sucre, poivre et les piments en julienne.","Hors du feu, ajouter le basilic. Servir sur le riz avec un œuf frit par personne."],"notes":"Accompagnement : riz jasmin, quantité à décider (non compté)."},"saute":{"nom":"Sauté de poulet haché au miso et au cari","lien":"https://www.ricardocuisine.com/recettes/10464-saute-de-poulet-hache-au-miso-et-au-cari","facteur":1.75,"temps":35,"quand":"mer-soir","decouverte":true,"ingredients":[{"section":"Sauce","texte":"79 ml de sauce soya réduite en sodium"},{"texte":"53 ml de miso"},{"texte":"53 ml de sirop d'érable"},{"texte":"53 ml de jus de lime"},{"texte":"9 ml de poudre de cari"},{"texte":"4 ml de sambal oelek"},{"section":"Sauté","texte":"790 g de haricots verts"},{"texte":"79 ml d'huile végétale"},{"texte":"790 g de poulet haché"},{"texte":"35 g de noix de coco râpée non sucrée"},{"texte":"Coriandre et lime, pour le service"},{"section":"Accompagnement","texte":"190 g de riz blanc sec (130 g cuit par assiette, suggéré par la recette)"}],"etapes":["Mélanger les ingrédients de la sauce.","Saisir les haricots dans 1 c. à soupe d'huile jusqu'à ce qu'ils soient colorés ; réserver.","Dorer le poulet haché dans le reste de l'huile en l'émiettant, ajouter la sauce 3 à 4 minutes jusqu'à ce qu'elle soit sirupeuse.","Remettre les haricots, servir garni de coco grillée et de coriandre."],"notes":"35 min au total d'après le site (15 + 20) : légèrement au-dessus de ta limite de 30 min en semaine. Riz suggéré, non compté."},"aiglefin":{"nom":"Aiglefin poché au lait de coco","lien":"https://www.ricardocuisine.com/recettes/10595-aiglefin-poche-au-lait-de-coco","facteur":1.25,"temps":33,"quand":"jeu-soir","decouverte":true,"ingredients":[{"texte":"840 g de filets d'aiglefin"},{"texte":"19 ml de gingembre frais haché"},{"texte":"1 gousse d'ail"},{"texte":"19 ml d'huile végétale"},{"texte":"498 ml de lait de coco"},{"texte":"13 ml de sauce de poisson"},{"texte":"6 ml de cassonade"},{"texte":"19 ml de chili crisp","nonCompte":true},{"texte":"1 oignon vert"},{"texte":"1 lime, en quartiers"}],"etapes":["Saler les pavés d'aiglefin.","Attendrir gingembre et ail dans l'huile, ajouter lait de coco, sauce de poisson et cassonade.","Déposer le poisson, porter à ébullition, couvrir et mijoter 6 minutes, puis 5 minutes de repos hors du feu.","Réduire la sauce 1 à 2 minutes, napper le poisson, garnir de chili crisp et d'oignon vert."],"notes":"Le poisson poché se réchauffe mal : à manger le jour même. Salade suggérée, non comptée."},"pois":{"nom":"Crème de petits pois, menthe et haloumi","lien":"https://christelleisflabbergasting.com/2018/11/creme-de-petits-pois-menthe-et-haloumi-de-josee-di-stasio.html","facteur":2,"temps":25,"quand":"ven-soir","ingredients":[{"texte":"60 ml de beurre"},{"texte":"2 poireaux (blanc et vert pâle)"},{"texte":"2 l de bouillon de poulet"},{"texte":"Sel, au goût"},{"texte":"1,5 kg de petits pois"},{"texte":"30 g de menthe ciselée"},{"texte":"400 g de fromage haloumi","nonCompte":true}],"etapes":["Faire suer le poireau dans le beurre 5 minutes à couvert.","Ajouter bouillon et sel, mijoter 5 minutes.","Ajouter petits pois et menthe, mijoter 2 minutes, réserver quelques pois.","Mixer en crème lisse.","Dorer l'haloumi à sec et le servir au centre de la soupe."],"notes":"Recette pour 4 à 6, comptée pour 4. Se congèle. ⚠ Le blog qui la publie montre des liens indésirables (casino) en haut de page : il a sans doute été piraté."},"soupe":{"nom":"Soupe aux boulettes et à la courge spaghetti","lien":"https://www.ricardocuisine.com/recettes/5546-soupe-aux-boulettes-et-a-la-courge-spaghetti","facteur":2.75,"temps":40,"quand":"sam-midi","ingredients":[{"texte":"610 g d'oignons, émincés"},{"texte":"83 ml de beurre"},{"texte":"8 gousses d'ail"},{"texte":"3 ml de flocons de piment broyé"},{"texte":"3,4 l de bouillon de poulet"},{"texte":"990 g de boulettes de veau"},{"texte":"1,4 l de courge spaghetti cuite"},{"texte":"170 g d'épinards"}],"etapes":["Attendrir les oignons dans le beurre, ajouter ail et piment.","Ajouter le bouillon et les boulettes, mijoter jusqu'à cuisson.","Ajouter la courge cuite et les épinards juste avant de servir."],"notes":"La courge se cuit d'avance au four (voir la recette). Plus de 30 minutes avec elle."},"bourguignon":{"nom":"Bœuf bourguignon","lien":"https://cuisine.journaldesfemmes.fr/recette/346736-boeuf-bourguignon","facteur":0.5,"temps":230,"quand":"sam-soir","ingredients":[{"texte":"750 g de bœuf pour bourguignon"},{"texte":"100 g de lardons"},{"texte":"30 g de beurre"},{"texte":"100 g de petits oignons"},{"texte":"1 carottes"},{"texte":"1 gousses d'ail"},{"texte":"30 g de farine"},{"texte":"250 ml de vin rouge"},{"texte":"250 ml de bouillon (2 cubes pour 50 cl d'eau)"},{"texte":"130 g de champignons"},{"texte":"bouquet garni, sel, poivre"},{"section":"Accompagnement","texte":"280 g de pâtes (tagliatelles) sec (195 g cuit par assiette, suggéré par la recette)"}],"etapes":["Couper le bœuf en cubes de 3 à 4 cm, peler les oignons, couper les carottes en rondelles.","Dorer oignons et lardons dans le beurre, les retirer.","Saisir la viande à feu vif, ajouter les carottes 5 minutes, puis la farine.","Mouiller avec le bouillon et le vin, remettre oignons et lardons, ajouter le bouquet garni et mijoter longuement.","Ajouter les champignons et cuire encore 30 minutes."],"notes":"Bien plus de 30 minutes (environ 3 h 50, surtout du mijotage). Accompagnement non compté."}},"courses":[{"id":"c1","nom":"Chapelure panko","rayon":"Boulangerie","qte":"70 g"},{"id":"c2","nom":"Bouillon de boeuf","rayon":"Épicer